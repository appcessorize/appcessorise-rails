<% details = legal_details %>
<% content_for :title, "#{heading} - Appcessorise" %>

<div class="min-h-screen bg-[oklch(98%_0_0)]">
  <%= render 'shared/navigation' %>

  <div class="bg-[oklch(14%_0.005_285.823)] py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-light text-[oklch(92%_0.004_286.32)]"><%= heading %></h1>
      <p class="mt-3 text-[color-mix(in_oklab,oklch(92%_0.004_286.32)_70%,transparent)] font-light">
        Last updated <%= details[:updated].strftime("%-d %B %Y") %>
      </p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <article class="bg-white rounded-2xl shadow-sm border border-[oklch(88%_0_0)] p-8 sm:p-10
                    text-[color-mix(in_oklab,oklch(21%_0.006_285.885)_80%,transparent)] font-light leading-relaxed
                    [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-[oklch(21%_0.006_285.885)] [&_h2]:mt-8 [&_h2]:mb-3
                    [&_h2:first-child]:mt-0
                    [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:mb-1
                    [&_a]:underline [&_a]:decoration-[oklch(70%_0_0)] hover:[&_a]:text-[oklch(21%_0.006_285.885)]">
      <%= yield %>

      <h2>Contact</h2>
      <p>Questions about this page? <%= link_to "Get in touch", contact_path %>.</p>
    </article>
  </div>

  <%= render 'shared/footer' %>
</div>
