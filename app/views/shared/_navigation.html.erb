<%# Minimal, borderless header: just the lowercase "appcessorise" wordmark. %>
<%# The old nav bar (boxed "A" logo + Home/Products/About/Contact links) has been removed. %>
<header class="w-full py-5 px-4 sm:px-8 flex items-center justify-between">
  <%= link_to root_path, class: "inline-flex items-baseline hover:opacity-80 transition-opacity", "aria-label": "Appcessorise home" do %>
    <span class="lowercase font-bold tracking-tight text-2xl sm:text-3xl text-[oklch(21%_0.006_285.885)]" style="font-family: 'Space Grotesk', sans-serif;">appcessorise</span><span class="font-bold text-2xl sm:text-3xl text-red-600" style="font-family: 'Space Grotesk', sans-serif;">.</span>
  <% end %>

  <% if user_signed_in? %>
    <nav class="flex items-center gap-4 sm:gap-6 text-sm font-medium">
      <%= link_to "Dashboard", dashboard_path, class: "text-[oklch(21%_0.006_285.885)] hover:text-red-600 transition-colors" %>
      <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "text-[oklch(21%_0.006_285.885)] hover:text-red-600 transition-colors cursor-pointer" %>
    </nav>
  <% end %>
</header>
