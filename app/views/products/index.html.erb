<% content_for :title, "Products - Appcessorise" %>

<div class="min-h-screen bg-white">
  <%= render 'shared/navigation' %>

  <!-- Header -->
  <div class="bg-[oklch(14%_0.005_285.823)] py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-[oklch(92%_0.004_286.32)] mb-4">
        The catalog your users can buy from
      </h1>
      <p class="text-lg sm:text-xl text-[color-mix(in_oklab,oklch(92%_0.004_286.32)_80%,transparent)] max-w-2xl mx-auto">
        Every product is printed and shipped by us. Your users' images go on it &mdash; you earn <span class="font-bold text-red-400"><%= commission_percent %></span> of every sale.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <% if @products.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @products.each do |product| %>
          <div class="bg-white rounded-2xl shadow-lg border border-[oklch(88%_0_0)] overflow-hidden flex flex-col">
            <div class="p-6 flex-1">
              <div class="flex items-start justify-between mb-2 gap-3">
                <h3 class="text-xl font-bold text-[oklch(21%_0.006_285.885)]"><%= product.name %></h3>
                <span class="text-lg font-bold text-[oklch(21%_0.006_285.885)]"><%= number_to_currency(product.base_price) %></span>
              </div>
              <% if product.description.present? %>
                <p class="text-sm text-[color-mix(in_oklab,oklch(21%_0.006_285.885)_70%,transparent)] mb-4"><%= truncate(product.description, length: 120) %></p>
              <% end %>
              <div class="space-y-1.5 text-sm text-[color-mix(in_oklab,oklch(21%_0.006_285.885)_70%,transparent)]">
                <p><span class="font-semibold text-red-600">You earn ~<%= number_to_currency(product.base_price * (ENV["DEFAULT_COMMISSION_RATE"]&.to_f || 0.15)) %></span> per sale</p>
                <p><%= pluralize(product.variant_data.size, "variant") %> (colors/sizes)</p>
                <p>API product id: <code class="bg-[oklch(95%_0_0)] px-1.5 py-0.5 rounded font-mono"><%= product.printful_product_id %></code></p>
              </div>
            </div>
            <div class="px-6 pb-6">
              <%= link_to "Integrate this product →", api_docs_path, class: "block text-center w-full px-4 py-2.5 bg-[oklch(14%_0.005_285.823)] hover:bg-black text-[oklch(92%_0.004_286.32)] rounded-lg font-medium transition" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty state: catalog not synced yet -->
      <div class="max-w-xl mx-auto text-center py-12">
        <div class="text-6xl mb-6">📦</div>
        <h2 class="text-2xl font-bold text-[oklch(21%_0.006_285.885)] mb-3">Catalog is being stocked</h2>
        <p class="text-[color-mix(in_oklab,oklch(21%_0.006_285.885)_70%,transparent)] mb-8">
          We're adding printable products &mdash; t-shirts, mugs, phone cases, posters and more. Meanwhile, the API is live: grab a key and see how the integration works.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <%= link_to "Read the API docs", api_docs_path, class: "px-6 py-3 bg-[oklch(14%_0.005_285.823)] hover:bg-black text-[oklch(92%_0.004_286.32)] rounded-lg font-medium transition" %>
          <%= link_to "Get your API key", new_user_registration_path, class: "px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition" %>
        </div>
      </div>
    <% end %>
  </div>

  <%= render 'shared/footer' %>
</div>
